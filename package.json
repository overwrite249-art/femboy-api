{
  "name": "femboy-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Femboy API - a serverless multi-provider AI API gateway (OpenAI / Anthropic / Gemini / Responses dialects) on Next.js + Vercel + MongoDB, with optional Redis coordination.",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types --no-warnings \"tests/**/*.test.ts\"",
    "test:security": "node --test --experimental-strip-types --no-warnings \"tests/security/**/*.test.ts\"",
    "test:unit": "node --test --experimental-strip-types --no-warnings \"tests/unit/**/*.test.ts\"",
    "harness": "node --experimental-strip-types --no-warnings scripts/harness.ts",
    "smoke": "node --experimental-strip-types --no-warnings scripts/smoke.ts",
    "db:indexes": "node --experimental-strip-types --no-warnings scripts/ensure-indexes.ts",
    "db:seed": "node --experimental-strip-types --no-warnings scripts/seed.ts",
    "bootstrap:admin": "node --experimental-strip-types --no-warnings scripts/create-admin.ts",
    "verify:billing": "node --experimental-strip-types --no-warnings scripts/verify-billing.ts",
    "check:secrets": "node --experimental-strip-types --no-warnings scripts/check-secrets.ts",
    "test:integration": "node --test --experimental-strip-types --no-warnings \"tests/integration/*.test.ts\"",
    "migrate:quota": "node --experimental-strip-types --no-warnings scripts/migrate-quota-ledger.ts"
  },
  "dependencies": {
    "lucide-react": "1.42.0",
    "mongodb": "^6.21.0",
    "next": "^15.5.25",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "undici": "^7.29.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
