# ---------------------------------------------------------------------------
# Femboy API - environment template
#
# Copy to .env.local for development. NEVER commit a filled-in copy.
# Generate every secret with:  openssl rand -hex 32
# ---------------------------------------------------------------------------

# --- storage (required) ----------------------------------------------------
# MongoDB Atlas connection string. Without it the gateway runs in ephemeral
# in-memory mode: everything works, nothing survives a restart.
MONGODB_URI=
MONGODB_DB=femboy_api
MONGODB_MAX_POOL_SIZE=10

# Upstash Redis REST credentials. Without them an in-process twin is used,
# which is correct for a single instance but cannot share state across
# serverless invocations - do not run production without it.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- secrets (required in production, >= 32 chars each) --------------------
# Pepper mixed into every API key digest. Rotating it invalidates all keys.
KEY_PEPPER=
# Master key for the AES-256-GCM envelope protecting upstream provider keys.
CHANNEL_KEY_MASTER=
CHANNEL_KEY_VERSION=1
# Signs console session cookies.
SESSION_SECRET=
# Required in the Authorization header of every /api/cron/* request.
CRON_SECRET=
# HMAC salt for client IP hashing. Raw addresses are never stored.
IP_HASH_SECRET=
# One-time token that allows creating the first root account.
ADMIN_BOOTSTRAP_TOKEN=

# --- billing ---------------------------------------------------------------
# Quota units per USD. 500000 => 1 quota unit = $0.000002
QUOTA_PER_UNIT=500000
# Held before a request runs, refunded/topped-up at settlement.
PRE_CONSUMED_QUOTA=1000

# --- retry / timeouts ------------------------------------------------------
RETRY_TIMES=3
RETRY_BUDGET_MS=60000
UPSTREAM_HEADER_TIMEOUT_MS=60000
STREAMING_IDLE_TIMEOUT_MS=300000
SSE_PING_INTERVAL_MS=15000

# --- request limits --------------------------------------------------------
MAX_REQUEST_BODY_MB=32
MAX_SSE_LINE_BYTES=1048576
MAX_UPSTREAM_RESPONSE_BYTES=67108864
MAX_JSON_DEPTH=64
MAX_JSON_NODES=200000

# --- provider defaults -----------------------------------------------------
ANTHROPIC_VERSION=2023-06-01
AZURE_DEFAULT_API_VERSION=2024-10-21
# Sends BLOCK_NONE safety settings to Gemini. Off by default.
GEMINI_SAFETY_OFF=false
# Allows http:// upstream base URLs. Refused in production.
ALLOW_PLAINTEXT_UPSTREAM=false

# --- channel health --------------------------------------------------------
CHANNEL_FAILURE_THRESHOLD=5
CHANNEL_COOLDOWN_SEC=60
CHANNEL_AUTO_DISABLE_FAILS=3
CHANNEL_TEST_CONCURRENCY=8
CHANNEL_TEST_MODEL=gpt-4o-mini

# --- cache TTLs (seconds) --------------------------------------------------
ABILITY_CACHE_TTL_SEC=60
CHANNEL_CACHE_TTL_SEC=300
TOKEN_CACHE_TTL_SEC=600
AFFINITY_TTL_SEC=1800
PRICING_CACHE_TTL_SEC=300

# --- rate limits -----------------------------------------------------------
DEFAULT_RPM=60
# 0 disables the tokens-per-minute limiter.
DEFAULT_TPM=0
DEFAULT_IP_RPM=120
DEFAULT_SUCCESS_PER_WINDOW=1000
DEFAULT_WINDOW_SEC=60

# --- network trust ---------------------------------------------------------
# How many proxies sit in front of this deployment. The client IP is taken
# this many entries from the RIGHT of X-Forwarded-For. On Vercel: 1.
TRUSTED_PROXY_HOPS=1
# Comma-separated CIDRs allowed to reach /api/admin/*. Empty = no IP filter.
ADMIN_ALLOWED_CIDRS=
# Comma-separated hostname suffixes. Empty = any public host is allowed.
UPSTREAM_DOMAIN_ALLOWLIST=
UPSTREAM_DOMAIN_DENYLIST=
UPSTREAM_ALLOWED_PORTS=443,8443
DOH_RESOLVER=https://cloudflare-dns.com/dns-query

# --- observability ---------------------------------------------------------
AXIOM_TOKEN=
AXIOM_DATASET=
LOG_LEVEL=info
LOG_SAMPLE_RATE=1
SENTRY_DSN=
# Minimum wall time for an auth decision, hiding key-existence timing.
MIN_AUTH_LATENCY_MS=30

# --- site ------------------------------------------------------------------
PUBLIC_BASE_URL=
SITE_NAME=Femboy API
REGISTRATION_ENABLED=true
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
